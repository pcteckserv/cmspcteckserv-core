{
    "name": "pcteckserv/cms-core-test-host",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "pcteckserv/cms-core": "^3.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/"}
    },
    "config": {"allow-plugins": false, "preferred-install": "dist", "sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
